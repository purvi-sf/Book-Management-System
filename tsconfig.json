{
  "compilerOptions": {
    "target": "ES2022", //compliles ts to ES2022 JS. 
    "module": "ES2022", //compiled files contain import/export statements 
    "moduleResolution": "bundler",
    "strict": false, //
    "experimentalDecorators": true, //allows log and validate 
    "emitDecoratorMetadata": true,
    "outDir": "./dist", //compiled js file in dist folder 
    "rootDir": "./src", //ts files in src 
    "sourceMap": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}